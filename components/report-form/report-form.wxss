/* 举报模态框样式 */
.report-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  z-index: 1000;
  touch-action: none;
  -webkit-overflow-scrolling: touch;
}

.report-modal-content {
  background-color: white;
  border-top-left-radius: 32rpx;
  border-top-right-radius: 32rpx;
  width: 100%;
  max-height: 85vh;
  box-shadow: 0 -8rpx 32rpx rgba(0, 0, 0, 0.12);
  touch-action: auto;
  -webkit-overflow-scrolling: touch;
  animation: slideUp 0.3s ease-out;
}

@keyframes slideUp {
  from {
    transform: translateY(100%);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

.report-form-scroll {
  height: calc(85vh - 120rpx);
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}

.report-modal-header {
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #f3f4f6;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.report-modal-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2937;
  margin-bottom: 4rpx;
}

.report-modal-subtitle {
  display: block;
  font-size: 24rpx;
  color: #9ca3af;
  margin-bottom: 4rpx;
  text-align: center;
  max-width: 80%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.report-modal-close {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  font-size: 36rpx;
  color: #9ca3af;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  transition: background-color 0.2s;
}

.report-modal-close:active {
  background-color: #f3f4f6;
}

.report-form {
  padding: 28rpx 32rpx;
}

.form-item {
  margin-bottom: 28rpx;
}

.form-label {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #374151;
  margin-bottom: 16rpx;
}

.required {
  color: #ef4444;
  font-size: 26rpx;
}

.reason-options {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.reason-option {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 20rpx;
  border: 2rpx solid #e5e7eb;
  border-radius: 12rpx;
  transition: all 0.2s;
}

.reason-option:active {
  background-color: #f9fafb;
}

.reason-option.selected {
  border-color: #ef4444;
  background-color: #fef2f2;
}

.reason-radio {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 2rpx solid #d1d5db;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: 4rpx;
  transition: all 0.2s;
}

.reason-radio.checked {
  border-color: #ef4444;
}

.reason-radio-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background-color: #ef4444;
}

.reason-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.reason-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #1f2937;
}

.reason-desc {
  display: block;
  font-size: 22rpx;
  color: #9ca3af;
  line-height: 1.4;
}

.form-textarea {
  width: 100%;
  min-height: 160rpx;
  padding: 16rpx;
  border: 2rpx solid #e5e7eb;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #1f2937;
  resize: none;
  box-sizing: border-box;
  line-height: 1.5;
}

.form-textarea:focus {
  border-color: #ef4444;
}

.form-textarea::placeholder {
  color: #d1d5db;
}

.textarea-counter {
  display: block;
  font-size: 22rpx;
  color: #d1d5db;
  text-align: right;
  margin-top: 8rpx;
}

.privacy-note {
  padding: 20rpx;
  background-color: #f9fafb;
  border-radius: 12rpx;
  display: flex;
  gap: 12rpx;
  align-items: flex-start;
  margin-bottom: 28rpx;
  border: 1rpx solid #f3f4f6;
}

.privacy-icon {
  font-size: 24rpx;
  flex-shrink: 0;
  margin-top: 2rpx;
}

.privacy-text {
  flex: 1;
  font-size: 22rpx;
  color: #6b7280;
  line-height: 1.6;
}

.guest-note {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 20rpx;
  background-color: #fffbeb;
  border: 1rpx solid #fde68a;
  border-radius: 12rpx;
  margin-bottom: 28rpx;
}

.guest-icon {
  font-size: 24rpx;
  flex-shrink: 0;
}

.guest-text {
  flex: 1;
  font-size: 22rpx;
  color: #92400e;
  line-height: 1.4;
}

.guest-login-btn {
  padding: 8rpx 20rpx;
  background-color: #f59e0b;
  color: white;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.guest-login-btn:active {
  background-color: #d97706;
}

.form-actions {
  display: flex;
  gap: 16rpx;
  padding-bottom: 20rpx;
}

.cancel-btn,
.submit-btn {
  flex: 1;
  padding: 20rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  transition: all 0.2s;
}

.cancel-btn {
  background-color: #f3f4f6;
  color: #6b7280;
  border: none;
}

.cancel-btn:active {
  background-color: #e5e7eb;
}

.submit-btn {
  background-color: #ef4444;
  color: white;
  border: none;
}

.submit-btn:active:not(:disabled) {
  background-color: #dc2626;
}

.submit-btn:disabled {
  background-color: #fecaca;
  color: #fca5a5;
}
