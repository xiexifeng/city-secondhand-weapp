page {
  background-color: #ffffff;
  overflow-x: hidden;
  width: 100%;
  box-sizing: border-box;
}

.home-container {
  min-height: 100vh;
  background-color: #ffffff;
  width: 100%;
  box-sizing: border-box;
  overflow-x: hidden;
}

/* ================== 新增：顶部并排综合高档容器 ================== */
.header-combined-zone {
  background-color: white;
  padding: 18rpx 24rpx;
  border-bottom: 1rpx solid #f3f4f6;
  position: sticky;
  top: 0;
  z-index: 10;
}

.search-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  width: 100%;
  box-sizing: border-box;
}

/* ================== 精修：左侧并排紧凑型位置胶囊 ================== */
.location-box-mini {
  display: flex;
  align-items: center;
  background: #f4fbfb;          /* 极其干净透亮的浅青绿偏白底色 */
  border: 1px solid #d3eded;    /* 融入绿调的高级细边框 */
  padding: 10rpx 16rpx;
  border-radius: 30rpx;         /* 胶囊圆角 */
  max-width: 190rpx;            /* 限制最大宽度，严防挤压右侧搜索框 */
  flex-shrink: 0;
  box-shadow: 0 2rpx 8rpx rgba(32, 153, 134, 0.03);
}

/* 纯 CSS 精准绘制：左侧青绿色迷你定位图标 */
.mock-location-icon-mini {
  position: relative;
  width: 16rpx;
  height: 16rpx;
  border: 3rpx solid #209986;   /* 设计稿核心清爽绿 */
  border-radius: 50% 50% 50% 0;
  transform: rotate(-45deg);
  margin-right: 8rpx;
  flex-shrink: 0;
}
.mock-location-icon-mini::after {
  content: '';
  position: absolute;
  width: 5rpx;
  height: 5rpx;
  background: #209986;
  border-radius: 50%;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}

/* 位置文本单行截断 */
.location-text-mini {
  font-size: 24rpx;
  font-weight: bold;
  color: #209986;               /* 与图标呼应的专属色 */
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 纯 CSS 精准绘制：右侧微弱下箭头 */
.mock-arrow-mini {
  width: 8rpx;
  height: 8rpx;
  border-right: 2rpx solid #209986;
  border-bottom: 2rpx solid #209986;
  transform: rotate(45deg);
  margin-left: 8rpx;
  margin-top: -4rpx;            /* 完美居中对齐 */
  flex-shrink: 0;
}

/* ================== 右侧修长内嵌式搜索框 ================== */
.search-input-wrapper-inline {
  flex: 1;
  display: flex;
  align-items: center;
  background-color: #F8FAFC;
  border-radius: 32rpx;
  padding-left: 20rpx;
  height: 64rpx;
  overflow: hidden;
  border: 1rpx solid #f1f5f9;
}

.search-icon-inline {
  font-size: 22rpx;
  color: #94A3B8;
  margin-right: 10rpx;
}

.search-input-inline {
  flex: 1;
  background: transparent;
  border: none;
  font-size: 26rpx;
  color: #334155;
  padding: 0;
  height: 100%;
}

.filter-btn-inline {
  height: 100%;
  padding: 0 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #209986;   /* 抛弃原有墨绿，使用更年轻现代的社区绿 */
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 600;
  border-top-right-radius: 32rpx;
  border-bottom-right-radius: 32rpx;
}
.filter-btn-inline:active {
  opacity: 0.9;
}

/* ================== 新增：高级轻量级呼吸感登录卡片 ================== */
.login-card-modern {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(135deg, #eefaf7 0%, #e2f6f2 100%); /* 温暖轻快的软绿微光渐变 */
  border: 1rpx solid #cbeee7;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin: 16rpx 24rpx 8rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(32, 153, 134, 0.04);
}

.login-card-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.login-waving-hand {
  font-size: 36rpx;
}

.login-text-content {
  display: flex;
  flex-direction: column;
}

.login-title-new {
  font-size: 26rpx;
  font-weight: bold;
  color: #1a4d43;               /* 高级深石墨绿 */
}

.login-desc-new {
  font-size: 22rpx;
  color: #4a7c73;
  margin-top: 2rpx;
}

.login-btn-mini {
  background: #209986;
  color: white;
  font-size: 24rpx;
  font-weight: bold;
  padding: 10rpx 24rpx;
  border-radius: 26rpx;
  box-shrink: 0;
  box-shadow: 0 4rpx 10rpx rgba(32, 153, 134, 0.15);
}
.login-btn-mini:active {
  opacity: 0.9;
  transform: scale(0.97);
}

/* ================== 筛选标签栏 (迎合整体色系调优) ================== */
.filter-tags {
  background-color: white;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #F1F5F9;
}

.tags-scroll {
  display: flex;
  padding: 0 24rpx;
  white-space: nowrap;
}

.tag-item {
  display: inline-block;
  padding: 8rpx 24rpx;
  margin-right: 14rpx;
  border: 1rpx solid #E2E8F0;
  border-radius: 24rpx;
  font-size: 24rpx;
  color: #475569;
  background-color: #F8FAFC;
  transition: all 0.2s;
  white-space: nowrap;
}

.tag-item:active {
  transform: scale(0.95);
}

.tag-item.tag-active {
  background-color: #209986;   /* 同步全局核心色 */
  color: white;
  border-color: #209986;
  font-weight: 500;
}

/* ================== 下方物品列表容器及卡片保持原样不变 ================== */
.items-container {
  padding: 16rpx 16rpx 24rpx;
  background-color: #ffffff;
  width: 100%;
  box-sizing: border-box;
  overflow-x: hidden;
}

.items-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  width: 100%;
  box-sizing: border-box;
}

.item-card {
  background-color: white;
  border-radius: 12rpx;
  overflow: hidden;
  border: 1rpx solid #EEF2F7;
  box-shadow: 0 2rpx 10rpx rgba(15, 23, 42, 0.06);
  transition: all 0.2s;
}

.item-card:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.12);
}

.item-image-wrapper {
  position: relative;
  width: 100%;
  padding-bottom: 100%;
  overflow: hidden;
  background: linear-gradient(135deg, #F8FAFC 0%, #EEF2F7 100%);
}

.item-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  background-color: #F8FAFC;
}

.item-badge {
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  background-color: #F97316;
  color: white;
  padding: 4rpx 8rpx;
  border-radius: 4rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.item-info {
  padding: 12rpx;
}

.item-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1F2937;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-bottom: 8rpx;
  line-height: 1.4;
}

.item-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 8rpx;
  font-size: 26rpx;
}

.item-price {
  font-weight: 700;
  color: #F97316;
  font-size: 30rpx;
  max-width: 280rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-want {
  font-weight: 600;
  color: #ea580c;
  font-size: 24rpx;
  background-color: #fff7ed;
  padding: 2rpx 8rpx;
  border-radius: 4rpx;
  max-width: 280rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-time {
  font-size: 20rpx;
  color: #9CA3AF;
  white-space: nowrap;
}

.item-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 22rpx;
  gap: 8rpx;
}

.item-tags {
  display: flex;
  gap: 4rpx;
  flex: 1;
  overflow: hidden;
  flex-wrap: wrap;
}

.item-tag {
  background-color: #F8FAFC;
  color: #475569;
  padding: 3rpx 8rpx;
  border-radius: 4rpx;
  font-size: 20rpx;
  white-space: nowrap;
  max-width: 120rpx;
  overflow: hidden;
  text-overflow: ellipsis;
}

.item-distance-tag {
  padding: 3rpx 10rpx;
  border-radius: 4rpx;
  font-size: 20rpx;
  font-weight: 600;
  white-space: nowrap;
  flex-shrink: 0;
}

.item-distance-tag.near {
  background-color: #ECFDF5;
  color: #10B981;
}

.item-distance-tag.remote {
  background-color: #FEF3C7;
  color: #D97706;
}

.loading-state,
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 20rpx;
  color: #64748B;
}

.loading-spinner {
  width: 40rpx;
  height: 40rpx;
  border: 3rpx solid #E5E7EB;
  border-top-color: #10B981;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.empty-icon {
  font-size: 60rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 28rpx;
}

.load-more {
  display: flex;
  justify-content: center;
  padding: 30rpx 0;
}

.loading-more {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: #64748B;
}

.spinner {
  width: 20rpx;
  height: 20rpx;
  border: 2rpx solid #E5E7EB;
  border-top-color: #10B981;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.no-more {
  color: #D1D5DB;
  font-size: 24rpx;
}

.audit-icon-wrapper {
  position: fixed;
  bottom: calc(140rpx + env(safe-area-inset-bottom));
  right: 24rpx;
  width: 90rpx;
  height: 90rpx;
  background-color: #F97316;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 36rpx;
  font-weight: bold;
  box-shadow: 0 8rpx 20rpx rgba(249, 115, 22, 0.4);
  z-index: 100;
  border: 4rpx solid rgba(255, 255, 255, 0.8);
}

.audit-icon-text {
  font-size: 44rpx;
  font-weight: bold;
}

.audit-icon-badge {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  min-width: 38rpx;
  height: 38rpx;
  background-color: #dc2626;
  color: white;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 19rpx;
  font-weight: bold;
  border: 3rpx solid white;
}

/* ================== 新增：未选择位置时的空白占位美化 ================== */
.location-empty-holder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 64rpx;
  text-align: center;
  box-sizing: border-box;
}

/* 带有微弱呼吸感的定位大图标 */
.empty-compass-icon {
  font-size: 96rpx;
  margin-bottom: 32rpx;
  animation: floatUpDown 3s ease-in-out infinite;
}

@keyframes floatUpDown {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-12rpx); }
}

/* 主提示标题 */
.empty-holder-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #1F2937;
  margin-bottom: 16rpx;
}

/* 引导解释小字 */
.empty-holder-desc {
  font-size: 26rpx;
  color: #64748B;
  line-height: 1.6;
  margin-bottom: 48rpx;
}

/* 引导去点击的胶囊按钮 */
.empty-location-btn {
  background-color: #209986;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  padding: 16rpx 64rpx;
  border-radius: 40rpx;
  border: none;
  box-shadow: 0 8rpx 20rpx rgba(32, 153, 134, 0.2);
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

/* 按钮点击反馈 */
.empty-location-btn:active {
  opacity: 0.9;
  transform: scale(0.97);
}