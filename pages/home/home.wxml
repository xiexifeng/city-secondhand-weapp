<view class="home-container">
  
  <view class="header-combined-zone">
    <view class="search-row">
      <view class="location-box-mini" bindtap="handleGetLocation">
        <view class="mock-location-icon-mini"></view>
        <text class="location-text-mini">{{locationLoaded ? (currentLocation === '请选择位置' ? '请选择位置' : currentLocation) : '请选择位置'}}</text>
        <view class="mock-arrow-mini"></view>
      </view>
      
      <view class="search-input-wrapper-inline">
        <text class="search-icon-inline">🔍</text>
        <input 
          class="search-input-inline" 
          type="text" 
          placeholder="搜索物品..." 
          placeholder-style="color: #94A3B8;"
          bindinput="onSearchInput"
          value="{{searchKeyword}}"
          confirm-type="search"
          bindconfirm="onSearch"
        />
        <view class="filter-btn-inline" bindtap="onSearch">
          <text>搜索</text>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{!isLoggedIn}}" class="login-card-modern">
    <view class="login-card-left">
      <view class="login-waving-hand">👋</view>
      <view class="login-text-content">
        <text class="login-title-new">欢迎来到换换么</text>
        <text class="login-desc-new">登录后可以发布物品、参与交易</text>
      </view>
    </view>
    <view class="login-btn-mini" bindtap="navigateToLogin">立即登录</view>
  </view>

  <view wx:if="{{locationLoaded}}">
    <view class="filter-tags">
      <scroll-view class="tags-scroll" scroll-x>
        <view 
          wx:for="{{tradeTypes}}" 
          wx:key="value"
          class="tag-item {{selectedTradeType === item.value ? 'tag-active' : ''}}"
          bindtap="onTradeTypeChange"
          data-value="{{item.value}}"
        >
          {{item.label}}
        </view>
      </scroll-view>
    </view>

    <!-- 排序选项 -->
    <view class="filter-tags">
      <scroll-view class="tags-scroll" scroll-x>
        <view 
          wx:for="{{sortOptions}}" 
          wx:key="value"
          class="tag-item {{selectedSort === item.value ? 'tag-active' : ''}}"
          bindtap="onSortChange"
          data-value="{{item.value}}"
        >
          {{item.label}}
        </view>
      </scroll-view>
    </view>

  <!-- 已获取位置后显示的内容（继续） -->
    <!-- 审核入口 -->
    <view class="audit-icon-wrapper" wx:if="{{showAuditIcon}}" bindtap="navigateToModeration">
      <view class="audit-icon-badge">{{auditCount}}</view>
      <text class="audit-icon-text">✓</text>
    </view>

    <!-- 物品列表 -->
    <view class="items-container">
      <!-- 加载中 -->
      <view wx:if="{{loading && items.length === 0}}" class="loading-state">
        <view class="loading-spinner"></view>
        <text>加载中...</text>
      </view>

      <!-- 空状态 -->
      <view wx:elif="{{!loading && items.length === 0}}" class="empty-state">
        <text class="empty-icon">📭</text>
        <text class="empty-text">暂无物品</text>
      </view>

      <!-- 物品网格 -->
      <view class="items-grid" wx:else>
        <view 
          wx:for="{{items}}" 
          wx:key="id"
          class="item-card"
          bindtap="onItemTap"
          data-id="{{item.id}}"
        >
          <!-- 图片 -->
          <view class="item-image-wrapper">
            <image 
              class="item-image" 
              src="{{item.image}}"
              mode="aspectFill"
              lazy-load="true"
              binderror="onImageError"
              data-index="{{index}}"
            />
            <view wx:if="{{item.urgent}}" class="item-badge">急出</view>
          </view>

          <view class="item-info">
            <text class="item-title">{{item.title}}</text>
            
            <!-- 价格/想换和时间 -->
            <view class="item-header">
              <view wx:if="{{item.price > 0}}" class="item-price">¥{{item.price}}</view>
              <view wx:elif="{{item.wantItem}}" class="item-want">想换: {{item.wantItem}}</view>
              <text class="item-time">{{item.formattedTime}}</text>
            </view>

            <!-- 标签和距离 -->
            <view class="item-footer">
              <view class="item-tags">
                <view wx:for="{{item.tags}}" wx:key="*this" class="item-tag">
                  {{item}}
                </view>
              </view>
              <view wx:if="{{item.formattedDistance}}" class="item-distance-tag {{item.distanceType}}">{{item.formattedDistance}}</view>
            </view>
          </view>
        </view>
      </view>

      <!-- 加载更多 -->
      <view wx:if="{{!loading && items.length > 0}}" class="load-more">
        <view wx:if="{{hasMore}}" class="loading-more">
          <view class="spinner"></view>
          <text>加载中...</text>
        </view>
        <view wx:else class="no-more">已到底部，分享邀请更多朋友加入吧</view>
      </view>
    </view>
  </view>
  <view wx:else class="location-empty-holder">
    <view class="empty-compass-icon">📍</view>
    <text class="empty-holder-title">开启位置探索换换之旅</text>
    <text class="empty-holder-desc">请点击左上角选择您所在的位置，即可为您精准推荐附近的超值物品</text>
    <button class="empty-location-btn" bindtap="handleGetLocation">立即选择位置</button>
  </view>

</view>