<!--pages/points-detail/points-detail.wxml-->
<view class="points-detail-container">
  <!-- Header -->
  <!-- <view class="header">
    <view class="header-left" bindtap="goBack">
      <text class="back-icon">‹</text>
    </view>
    <view class="header-center">
      <text class="header-title">积分明细</text>
    </view>
    <view class="header-right"></view>
  </view> -->

  <!-- Points Summary -->
  <view class="points-summary">
    <view class="summary-card">
      <view class="summary-header">
        <text class="summary-icon">⚡</text>
        <text class="summary-label">当前积分</text>
      </view>
      <view class="summary-value">
        <text class="summary-number">{{totalPoints}}</text>
        <text class="summary-unit">积分</text>
      </view>
      <text class="summary-desc">{{monthEarnDesc}}</text>
    </view>
  </view>

  <!-- Date Filter -->
  <view class="date-filter">
    <view class="filter-section">
      <text class="filter-label">选择年月</text>
      <picker mode="date" fields="month" value="{{dateValue}}" bindchange="onDateChange">
        <view class="filter-picker">
          <text class="filter-value">{{selectedYear}}年{{selectedMonth}}月</text>
          <text class="filter-arrow">▼</text>
        </view>
      </picker>
    </view>
  </view>

  <!-- Points History -->
  <scroll-view class="points-history" scroll-y="true" bindscrolltolower="loadMore" lower-threshold="100">
    <view class="section-header">
      <text class="section-title">积分记录</text>
      <text class="section-count"> 共 {{totalCount}} 条</text>
    </view>

    <view class="history-list" wx:if="{{pointsHistory.length > 0}}">
      <view wx:for="{{pointsHistory}}" wx:key="id" class="history-item">
        <view class="history-item-left">
          <view class="history-icon {{item.type}}">
            {{item.icon}}
          </view>
          <view class="history-info">
            <text class="history-title">{{item.title}}</text>
            <text class="history-time">{{item.time}}</text>
          </view>
        </view>
        <view class="history-item-right">
          <text class="history-points {{item.type}}">{{item.points > 0 ? '+' : ''}}{{item.points}} 积分</text>
        </view>
      </view>
    </view>

    <view class="empty-state" wx:if="{{pointsHistory.length === 0 && !isLoading}}">
      <text class="empty-icon">📭</text>
      <text class="empty-text">暂无积分记录</text>
    </view>

    <!-- 加载中提示 -->
    <view class="loading-more" wx:if="{{isLoading}}">
      <text>加载中...</text>
    </view>

    <!-- 没有更多数据提示 -->
    <view class="no-more" wx:if="{{!hasMore && pointsHistory.length > 0}}">
      <text>没有更多了</text>
    </view>
  </scroll-view>
</view>