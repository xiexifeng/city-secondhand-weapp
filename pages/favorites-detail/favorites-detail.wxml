<!--pages/favorites-detail/favorites-detail.wxml-->
<view class="favorites-detail-container">
  <!-- Tab Bar -->
  <view class="tab-bar">
    <view class="tab-item {{activeTab === 'items' ? 'active' : ''}}" bindtap="switchTab" data-tab="items">
      <text class="tab-text">物品收藏</text>
    </view>
    <view class="tab-item {{activeTab === 'wishes' ? 'active' : ''}}" bindtap="switchTab" data-tab="wishes">
      <text class="tab-text">心愿收藏</text>
    </view>
  </view>

  <!-- Items Favorites -->
  <view wx:if="{{activeTab === 'items'}}" class="favorites-section">
    <!-- 加载中 -->
    <view wx:if="{{loading && itemsList.length === 0}}" class="loading-state">
      <view class="loading-spinner"></view>
      <text>加载中...</text>
    </view>

    <!-- 空状态 -->
    <view wx:elif="{{!loading && itemsList.length === 0}}" class="empty-state">
      <text class="empty-icon">📭</text>
      <text class="empty-text">暂无物品收藏</text>
    </view>

    <view wx:else class="favorites-list">
      <block wx:for="{{itemsList}}" wx:key="id">
        <view class="item-card" bindtap="navigateToItemDetail" data-id="{{item.id}}">
          <view class="item-view">
            <view class="item-header">
              <image class="item-image" src="{{item.image}}" mode="aspectFill"></image>
              <view class="item-info">
                <view class="item-title-row">
                  <text class="item-title">{{item.title}}</text>
                </view>
                <text class="item-date">收藏于 {{item.time}}</text>

                <view class="item-badges">
                  <text wx:if="{{item.price > 0}}" class="item-price">¥{{item.price}}</text>
                  <text wx:else class="item-price">以物换物</text>
                  <view wx:if="{{item.transactionType === 'exchange' && item.exchangeItem}}" class="exchange-badge">
                    换：{{item.exchangeItem}}
                  </view>
                </view>

                <view class="item-stats">
                  <text class="stat-item">👁️ {{item.views}}</text>
                  <text class="stat-item">❤️ {{item.interested}}</text>
                  <text class="stat-item">⭐ {{item.collected}}</text>
                </view>
              </view>
            </view>
            <view class="item-footer">
              <view class="favorite-action" catchtap="removeFavorite" data-id="{{item.id}}" data-type="items">
                <text class="favorite-action-text">取消收藏</text>
              </view>
            </view>
          </view>
        </view>
      </block>
    </view>

    <!-- 加载更多 -->
    <view wx:if="{{!loading && itemsList.length > 0}}" class="load-more">
      <view wx:if="{{itemsHasMore}}" class="loading-more">
        <view class="spinner"></view>
        <text>加载中...</text>
      </view>
      <view wx:else class="no-more">已到底部</view>
    </view>
  </view>

  <!-- Wishes Favorites -->
  <view wx:if="{{activeTab === 'wishes'}}" class="favorites-section">
    <!-- 加载中 -->
    <view wx:if="{{loading && wishesList.length === 0}}" class="loading-state">
      <view class="loading-spinner"></view>
      <text>加载中...</text>
    </view>

    <!-- 空状态 -->
    <view wx:elif="{{!loading && wishesList.length === 0}}" class="empty-state">
      <text class="empty-icon">📭</text>
      <text class="empty-text">暂无心愿收藏</text>
    </view>

    <view wx:else class="favorites-list">
      <block wx:for="{{wishesList}}" wx:key="id">
        <view class="wish-card" bindtap="navigateToWishDetail" data-id="{{item.id}}">
          <view class="wish-view">
            <view class="wish-header">
              <text class="wish-icon">❤️</text>
              <view class="wish-content">
                <text class="wish-title">{{item.title}}</text>
                <text class="wish-description">{{item.description}}</text>
              </view>
            </view>

            <view class="wish-footer">
              <text class="wish-date">收藏于 {{item.time}}</text>
              <view class="wish-stats">
                <text class="stat-item">👁️ {{item.views || 0}}</text>
                <text class="stat-item">❤️ {{item.interested || 0}}</text>
                <text class="stat-item">⭐ {{item.collected || 0}}</text>
              </view>
            </view>
            <view class="wish-actions">
              <view class="favorite-action" catchtap="removeFavorite" data-id="{{item.id}}" data-type="wishes">
                <text class="favorite-action-text">取消收藏</text>
              </view>
            </view>
          </view>
        </view>
      </block>
    </view>

    <!-- 加载更多 -->
    <view wx:if="{{!loading && wishesList.length > 0}}" class="load-more">
      <view wx:if="{{wishesHasMore}}" class="loading-more">
        <view class="spinner"></view>
        <text>加载中...</text>
      </view>
      <view wx:else class="no-more">已到底部</view>
    </view>
  </view>
</view>